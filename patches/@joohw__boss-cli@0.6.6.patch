+import type {Page} from 'puppeteer-core';
+export type GreetingDeliveryEvidence = {
+    candidateId: string;
+    providerCandidateId: string | number;
+    conversationId: string;
+    observedAt: number;
+    messages: Array<{mid: string; serverMid?: string; time: number; status: number; isSelf: boolean | number; type: string; text: string}>;
+};
+export declare function readGreetingDeliveryEvidence(page: Page, candidateId: string, body: string, startedAt: number): Promise<GreetingDeliveryEvidence>;
+export declare function verifyGreetingDeliveryEvidence(evidence: GreetingDeliveryEvidence, expected: {
+    candidateId: string; providerCandidateId: string; body: string; startedAt: number;
+}): {candidateId: string; providerCandidateId: string; conversationId: string; serverMid: string; status: number; text: string; sentAt: string};
diff --git a/dist/toolset/greeting-delivery.js b/dist/toolset/greeting-delivery.js
new file mode 100644
index 0000000000000000000000000000000000000000..732e3ad86c81c046ac0d45604adc42f521db31e6
--- /dev/null
+++ b/dist/toolset/greeting-delivery.js
@@ -0,0 +0,67 @@
+import { runOpenCandidateChat } from './chat.js';
+
+function id(value) {
+    if (typeof value === 'string' && value.trim()) return value.trim();
+    if (typeof value === 'number' && Number.isSafeInteger(value) && value > 0) return String(value);
+    return '';
+}
+
+// Opening an existing conversation is read-only; this never invokes any send handler.
+export async function readGreetingDeliveryEvidence(page, candidateId, body, startedAt) {
+    await runOpenCandidateChat(page, `__boss_geek_id__:${encodeURIComponent(candidateId)}`, true);
+    await page.waitForFunction(`(() => {
+        const c = document.querySelector('.conversation-message')?.__vue__;
+        return (c?.conversation$?.encryptUid || c?.conversation$?.encryptGeekId) === ${JSON.stringify(candidateId)} &&
+            c?.list$?.some(m => (m.isSelf === true || m.isSelf === 1) && m.type === 'text' &&
+                m.text === ${JSON.stringify(body)} && [1, 2].includes(Number(m.status)) &&
+                Number(m.time) >= ${JSON.stringify(startedAt)} - 2000);
+    })()`, {timeout: 10_000});
+    return page.evaluate(`(() => {
+        const expectedId = ${JSON.stringify(candidateId)};
+        const hosts = Array.from(document.querySelectorAll('.conversation-message')).filter(el => {
+            const r = el.getBoundingClientRect(); const s = getComputedStyle(el);
+            return r.width > 0 && r.height > 0 && s.visibility !== 'hidden' && s.display !== 'none';
+        });
+        if (hosts.length !== 1) throw new Error('BOSS_GREET_POST_WRITE_CONVERSATION_MISSING');
+        const vm = hosts[0].__vue__;
+        const c = vm?.conversation$;
+        if ((c?.encryptUid || c?.encryptGeekId) !== expectedId || !Array.isArray(vm?.list$)) {
+            throw new Error('BOSS_GREET_POST_WRITE_TARGET_MISMATCH');
+        }
+        return {
+            candidateId: c.encryptUid || c.encryptGeekId,
+            providerCandidateId: String(c.friendId || c.uid || ''),
+            conversationId: String(c.uniqueId || ''),
+            observedAt: Date.now(),
+            messages: vm.list$.filter(m => m.isSelf === true || m.isSelf === 1).map(m => ({
+                mid: String(m.mid || ''), serverMid: String(m.serverMid || ''), time: Number(m.time),
+                status: Number(m.status), isSelf: true, type: m.type, text: m.text
+            }))
+        };
+    })()`);
+}
+
+export function verifyGreetingDeliveryEvidence(evidence, expected) {
+    if (!id(expected.providerCandidateId) || evidence.candidateId !== expected.candidateId ||
+        !id(evidence.providerCandidateId) || !id(evidence.conversationId) ||
+        ![evidence.candidateId, id(evidence.providerCandidateId)].includes(id(expected.providerCandidateId))) {
+        throw new Error('BOSS_GREET_POST_WRITE_TARGET_MISMATCH：开聊响应与实际聊天候选人不一致。');
+    }
+    if (!Number.isFinite(expected.startedAt) || !Number.isFinite(evidence.observedAt) ||
+        evidence.observedAt < expected.startedAt || !Array.isArray(evidence.messages)) {
+        throw new Error('BOSS_GREET_POST_WRITE_ACK_INVALID：缺少本次发送时间或聊天记录。');
+    }
+    const matches = evidence.messages.filter(m =>
+        (m.isSelf === true || m.isSelf === 1) && m.type === 'text' && m.text === expected.body &&
+        [1, 2].includes(Number(m.status)) && id(m.serverMid || m.mid) && Number.isFinite(m.time) &&
+        m.time >= expected.startedAt - 2000 && m.time <= expected.startedAt + 120000 &&
+        m.time <= evidence.observedAt + 2000);
+    const messages = new Map(matches.map(m => [id(m.serverMid || m.mid), m]));
+    if (messages.size !== 1) {
+        throw new Error('BOSS_GREET_POST_WRITE_ACK_MISSING：未取得唯一的本次完整招呼语及 BOSS 消息编号，请核验且勿重发。');
+    }
+    const [serverMid, message] = [...messages.entries()][0];
+    return { candidateId: expected.candidateId, providerCandidateId: id(evidence.providerCandidateId),
+        conversationId: evidence.conversationId, serverMid, status: Number(message.status),
+        text: message.text, sentAt: new Date(message.time).toISOString() };
+}
