@@ -0,0 +0,104 @@
+import { withBossSessionPage } from '../common/boss_session_page.js';
+
+const JOB_GREETING_URL = '/wapi/zpchat/greeting/job/get';
+
+function nonEmptyText(value) {
+    return typeof value === 'string' && value.trim() ? value.trim() : '';
+}
+
+function normalizeJob(value) {
+    return nonEmptyText(value).replace(/\s+/g, '').toLocaleLowerCase('zh-CN');
+}
+
+function safeIdentifier(value, field) {
+    const text = nonEmptyText(value);
+    if (!text || text.length > 256 || !/^[A-Za-z0-9_~=-]+$/u.test(text)) {
+        throw new Error(`BOSS_GREETING_CONFIG_INVALID：${field} 缺失或格式无效。`);
+    }
+    return text;
+}
+
+function exactBody(value, source) {
+    if (typeof value !== 'string' || !value.trim()) {
+        throw new Error(`BOSS_GREETING_BODY_EMPTY：${source}招呼语为空，已停止。`);
+    }
+    if (value.length < 2 || value.length > 500) {
+        throw new Error(`BOSS_GREETING_BODY_INVALID：${source}招呼语长度不在安全范围内。`);
+    }
+    return value;
+}
+
+export function resolveEffectiveGreeting(jobResponse, jobKeyword) {
+    const keyword = nonEmptyText(jobKeyword);
+    if (!keyword) {
+        throw new Error('BOSS_GREETING_JOB_REQUIRED：必须指定本次打招呼对应的 BOSS 岗位。');
+    }
+    if (!jobResponse || Number(jobResponse.code) !== 0) {
+        throw new Error(`BOSS_GREETING_JOB_CONFIG_UNAVAILABLE：${nonEmptyText(jobResponse?.message) || '岗位招呼语接口返回失败。'}`);
+    }
+    const jobs = Array.isArray(jobResponse?.zpData?.jobs) ? jobResponse.zpData.jobs : [];
+    const wanted = normalizeJob(keyword);
+    const exactMatches = jobs.filter((job) => {
+        const id = nonEmptyText(job?.encJobId);
+        return id === keyword || normalizeJob(job?.jobName) === wanted;
+    });
+    if (exactMatches.length === 0) {
+        throw new Error(`BOSS_GREETING_JOB_NOT_FOUND：没有找到岗位“${keyword}”的招呼语配置。`);
+    }
+    if (exactMatches.length !== 1) {
+        throw new Error(`BOSS_GREETING_JOB_AMBIGUOUS：岗位“${keyword}”精确匹配到 ${exactMatches.length} 项，无法唯一确定。`);
+    }
+    const job = exactMatches[0];
+    const jobId = safeIdentifier(job.encJobId, 'encJobId');
+    const jobName = nonEmptyText(job.jobName);
+    if (!jobName) {
+        throw new Error('BOSS_GREETING_CONFIG_INVALID：岗位名称为空。');
+    }
+    if (typeof job.jobGreeting === 'string' && job.jobGreeting.trim()) {
+        return {
+            schemaVersion: 1,
+            kind: 'greeting-preview',
+            source: 'job',
+            jobId,
+            jobName,
+            greetingId: safeIdentifier(job.encGreetingId, 'encGreetingId'),
+            body: exactBody(job.jobGreeting, '岗位')
+        };
+    }
+    throw new Error('BOSS_GREETING_JOB_BODY_EMPTY：该岗位没有专属招呼语，已停止。请先在 BOSS 为此岗位配置明确文案；系统不会猜测或回退到全局文案。');
+}
+
+async function readJobGreetingResponse(page) {
+    return (await page.evaluate(`(async () => {
+        const response = await fetch(${JSON.stringify(JOB_GREETING_URL)}, {
+          method: "GET",
+          credentials: "include",
+          headers: {
+            Accept: "application/json, text/plain, */*",
+            "X-Requested-With": "XMLHttpRequest"
+          }
+        });
+        if (!response.ok) {
+          throw new Error(${JSON.stringify(JOB_GREETING_URL)} + " HTTP " + response.status);
+        }
+        return response.json();
+    })()`));
+}
+
+export async function readEffectiveGreeting(page, jobKeyword) {
+    return resolveEffectiveGreeting(await readJobGreetingResponse(page), jobKeyword);
+}
+
+export async function runGreetingPreview(options) {
+    const jobKeyword = nonEmptyText(options.jobKeyword);
+    try {
+        return await withBossSessionPage(async (page) => {
+            const preview = await readEffectiveGreeting(page, jobKeyword);
+            return JSON.stringify(preview);
+        });
+    }
+    catch (error) {
+        const message = error instanceof Error ? error.message : String(error);
+        throw new Error(`读取打招呼预览失败：${message}`);
+    }
+}
