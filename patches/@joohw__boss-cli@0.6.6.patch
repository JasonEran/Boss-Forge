+/** Use the page's native, server-checked chat handler with the exact approved job/body. */
+export async function dispatchApprovedGreeting(frame, input, execute = true) {
+    if (!input.candidateId || !input.jobId || !input.body) throw new Error('BOSS_GREET_APPROVAL_INVALID：缺少候选人、岗位或招呼语。');
+    return frame.evaluate(`(() => {
+      const input = ${JSON.stringify(input)};
+      const execute = ${JSON.stringify(execute)};
+      const blocked = (code, message) => ({ candidateId: input.candidateId, jobId: input.jobId, invoked: false, blocked: { code, message } });
+      const nodes = Array.from(document.querySelectorAll('.candidate-card-wrap'));
+      const matches = nodes.filter(node => {
+        const inner = node.querySelector('.card-inner') || node;
+        return (inner.getAttribute('data-geekid') || inner.getAttribute('data-geek')) === input.candidateId;
+      });
+      if (matches.length !== 1) return blocked('BOSS_GREET_TARGET_UNVERIFIED', '当前卡片不能唯一对应已确认候选人，本次未发送。');
+      const card = matches[0];
+      const button = card.querySelector('button.btn-greet');
+      const vm = card.__vue__?.$refs?.['button-chat'];
+      if (!vm || vm.personInfo?.encryptGeekId !== input.candidateId) {
+        return blocked('BOSS_GREET_TARGET_UNVERIFIED', '候选人身份未能核对，本次未发送。');
+      }
+      if (vm.isFriend === true || Number(vm.isFriend) === 1) {
+        return blocked('BOSS_GREET_ALREADY_CONTACTED', 'BOSS 已与这位候选人建立联系，请使用继续沟通；本次未重复打招呼。');
+      }
+      if (!button || button.disabled || button.classList.contains('disabled') ||
+          typeof vm.chatStop !== 'function' || vm.isLoadding) {
+        return blocked('BOSS_GREET_TARGET_NOT_READY', '候选人的打招呼入口尚未就绪，本次未发送，请稍后重新预览。');
+      }
+      const jobs = (vm.onlineJobList || []).filter(job => job.jid === input.jobId);
+      if (jobs.length !== 1) return blocked('BOSS_GREET_JOB_UNAVAILABLE', '已确认的岗位不在当前账号可联系岗位中，本次未发送。');
+      // chatStop is the official one-request handler used by the native job
+      // chooser. Its explicit jobId takes precedence over the card's old viewing
+      // job. BOSS still evaluates entitlement, quota and account restrictions.
+      if (execute) vm.chatStop({ jobId: input.jobId, greet: input.body });
+      return { candidateId: input.candidateId, jobId: input.jobId, invoked: execute };
+    })()`);
+}
