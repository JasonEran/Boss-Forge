# M0 defaults to OCR disabled because boss-cli OCR calls an external Baidu service.
BOSS_RESUME_OCR=0

# Full-resume screening opens real candidate resumes, so keep it disabled during tests.
BOSS_FORGE_RESUME_PREVIEW_ENABLED=0
# Resume reading policy. The daily setting is clamped to the hard maximum of 200.
BOSS_FORGE_RESUME_DWELL_MIN_SECONDS=10
BOSS_FORGE_RESUME_DWELL_TARGET_SECONDS=10
BOSS_FORGE_RESUME_DWELL_MAX_SECONDS=10
BOSS_FORGE_RESUME_DAILY_LIMIT=120
BOSS_FORGE_RESUME_HOURLY_LIMIT=50
BOSS_FORGE_RESUME_BATCH_SIZE=20
BOSS_FORGE_RESUME_BREAK_MINUTES=10
BOSS_FORGE_RESUME_WORKDAY_START_HOUR=9
BOSS_FORGE_RESUME_WORKDAY_END_HOUR=18
# OCR provider: tencent uses the screenshot created by boss-cli; boss uses boss-cli's built-in OCR.
BOSS_FORGE_OCR_PROVIDER=tencent
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_OCR_REGION=ap-guangzhou

# Optional OpenAI-compatible semantic extractor. Enabling requires an HTTPS base URL,
# approved model, and a newly rotated non-empty API key. Keep it in shadow mode.
BOSS_FORGE_SEMANTIC_ENABLED=0
BOSS_FORGE_SEMANTIC_BASE_URL=
BOSS_FORGE_SEMANTIC_MODEL=
# Optional backup, used only if the primary fails; retains the configured timeout; primary is capped at 90s when a backup exists.
BOSS_FORGE_SEMANTIC_FALLBACK_MODEL=
BOSS_FORGE_SEMANTIC_API_KEY=
BOSS_FORGE_SEMANTIC_TIMEOUT_MS=45000

# Legacy boss-cli OCR provider settings (external Baidu OCR).
# BOSS_BAIDU_API_KEY=
# BOSS_BAIDU_SECRET_KEY=

# Stable logical identifiers used in worker heartbeat and account locks.
BOSS_FORGE_WORKER_ID=worker-local-01
BOSS_FORGE_ACCOUNT_ID=boss-account-01
# Legacy variable name: this arms both independent real actions (job greeting
# and previewed message), but only when dispatch mode is also exactly real.
BOSS_FORGE_REAL_GREET_ENABLED=0
# disabled = preview only (default); fake = explicit simulation worker; real =
# accepted compiled transport plus the independent real-contact gate. Real mode
# also requires the shared signing key below and the worker's explicit CLI guard.
BOSS_FORGE_CONTACT_DISPATCH_MODE=disabled
# Required in real mode. API and Worker must receive the same deployment-only
# secret with at least 32 UTF-8 bytes; never commit the actual value.
BOSS_FORGE_CONTACT_PREVIEW_SIGNING_KEY=
BOSS_FORGE_RELEASE_ID=local-development

# M1 control-plane database and local API.
DATABASE_URL=postgres://boss_forge:boss_forge_dev@127.0.0.1:55433/boss_forge
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=3100
CONTROL_WEB_ORIGIN=http://localhost:3000

# Created only when the users table is empty. Replace the default password before department use.
BOSS_FORGE_BOOTSTRAP_DEPARTMENT=默认招聘部门
BOSS_FORGE_BOOTSTRAP_ADMIN_EMAIL=admin@boss-forge.internal
BOSS_FORGE_BOOTSTRAP_ADMIN_NAME=HR 管理员
BOSS_FORGE_BOOTSTRAP_PASSWORD=ChangeMe-BossForge-Internal!

# Optional runtime directory. Defaults to <repo>/.boss-forge/runtime.
# BOSS_FORGE_RUNTIME_DIR=/absolute/path/to/runtime

# Optional root containing a project-private Chrome installed by the M0 browser command.
# BOSS_FORGE_BROWSER_ROOT=/absolute/path/to/browsers

# Optional boss-cli browser isolation settings.
# BOSS_BROWSER_USER_DATA_DIR=/absolute/path/to/browser-data
# BOSS_BROWSER_PROFILE_DIRECTORY=Default
# BOSS_BROWSER_REMOTE_DEBUGGING_PORT=53470
