# M0 defaults to OCR disabled because boss-cli OCR calls an external Baidu service.
BOSS_RESUME_OCR=0

# Full-resume screening opens real candidate resumes, so keep it disabled during tests.
BOSS_FORGE_RESUME_PREVIEW_ENABLED=0
# OCR provider: tencent uses the screenshot created by boss-cli; boss uses boss-cli's built-in OCR.
BOSS_FORGE_OCR_PROVIDER=tencent
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_OCR_REGION=ap-guangzhou

# Legacy boss-cli OCR provider settings (external Baidu OCR).
# BOSS_BAIDU_API_KEY=
# BOSS_BAIDU_SECRET_KEY=

# Stable logical identifiers used in worker heartbeat and account locks.
BOSS_FORGE_WORKER_ID=worker-local-01
BOSS_FORGE_ACCOUNT_ID=boss-account-01
BOSS_FORGE_REAL_GREET_ENABLED=0

# M1 control-plane database and local API.
DATABASE_URL=postgres://boss_forge:boss_forge_dev@127.0.0.1:55433/boss_forge
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=3100

# Optional runtime directory. Defaults to <repo>/.boss-forge/runtime.
# BOSS_FORGE_RUNTIME_DIR=/absolute/path/to/runtime

# Optional root containing a project-private Chrome installed by the M0 browser command.
# BOSS_FORGE_BROWSER_ROOT=/absolute/path/to/browsers

# Optional boss-cli browser isolation settings.
# BOSS_BROWSER_USER_DATA_DIR=/absolute/path/to/browser-data
# BOSS_BROWSER_PROFILE_DIRECTORY=Default
# BOSS_BROWSER_REMOTE_DEBUGGING_PORT=53470
