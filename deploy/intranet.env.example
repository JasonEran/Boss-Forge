# Copy to deploy/.env.intranet; .env.* files are ignored by Git.
COMPOSE_PROJECT_NAME=boss-forge-intranet
INTRANET_BIND_IP=127.0.0.1
BOSS_WEB_PORT=3000
BOSS_API_PORT=3100
CONTROL_WEB_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_CONTROL_API_URL=http://127.0.0.1:3100

# Resolve these to approved digests before a formal internal release.
POSTGRES_IMAGE=postgres:17-alpine
NODE_IMAGE=node:22-bookworm-slim
BOSS_FORGE_IMAGE=boss-forge:intranet

BOSS_DB_NAME=boss_forge
BOSS_DB_USER=boss_forge
# Generate URL-safe credentials with `openssl rand -hex 32`.
BOSS_DB_PASSWORD=CHANGE_ME_BOSS_DB_PASSWORD
BOSS_FORGE_CONTACT_WORKER_ID=contact-fake-01

BOSS_FORGE_WORKER_ID=worker-ubuntu-01
BOSS_FORGE_ACCOUNT_ID=boss-account-01
BOSS_FORGE_RESUME_PREVIEW_ENABLED=0
BOSS_FORGE_OCR_PROVIDER=tencent
BOSS_RESUME_OCR=0
TENCENTCLOUD_SECRET_ID=CHANGE_ME_TENCENT_SECRET_ID
TENCENTCLOUD_SECRET_KEY=CHANGE_ME_TENCENT_SECRET_KEY
TENCENTCLOUD_OCR_REGION=ap-guangzhou
BOSS_BROWSER_PROFILE_DIRECTORY=Default
BOSS_BROWSER_REMOTE_DEBUGGING_PORT=53470

# Optional OpenAI-compatible semantic model. Keep disabled until shadow evaluation is approved.
BOSS_FORGE_SEMANTIC_ENABLED=0
BOSS_FORGE_SEMANTIC_MODE=shadow
BOSS_FORGE_SEMANTIC_BASE_URL=
BOSS_FORGE_SEMANTIC_MODEL=
BOSS_FORGE_SEMANTIC_API_KEY=
BOSS_FORGE_SEMANTIC_TIMEOUT_MS=45000

# Real greeting remains absent from this Compose topology.
