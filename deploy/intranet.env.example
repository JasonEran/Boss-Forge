# Copy to deploy/.env.intranet; existing .env.* gitignore covers the runtime file.
COMPOSE_PROJECT_NAME=boss-forge-intranet
INTRANET_BIND_IP=127.0.0.1
ODOO_HTTP_PORT=8069
BOSS_API_PORT=3100
CONTROL_WEB_ORIGIN=http://127.0.0.1:3000

# Resolve these to approved digests before production cutover.
ODOO_IMAGE=odoo:19.0
POSTGRES_IMAGE=postgres:17-alpine
NODE_IMAGE=node:22-bookworm-slim
BOSS_FORGE_IMAGE=boss-forge:intranet

ODOO_DB_NAME=boss_forge_odoo
ODOO_DB_USER=boss_forge_odoo
# Use URL-safe hex for database credentials and keep runtime secrets out of Git.
ODOO_DB_PASSWORD=CHANGE_ME_ODOO_DB_PASSWORD
ODOO_ADMIN_LOGIN=admin
ODOO_ADMIN_PASSWORD=CHANGE_ME_ODOO_ADMIN_PASSWORD
ODOO_API_KEY=CHANGE_ME_ODOO_SERVICE_USER_API_KEY

BOSS_DB_NAME=boss_forge
BOSS_DB_USER=boss_forge
# Generate DB passwords/tokens with `openssl rand -hex 32`; avoid URL delimiters.
BOSS_DB_PASSWORD=CHANGE_ME_BOSS_DB_PASSWORD
BOSS_FORGE_SERVICE_TOKEN=CHANGE_ME_LONG_RANDOM_SERVICE_TOKEN
BOSS_FORGE_ODOO_SYNC_WORKER_ID=odoo-sync-01
BOSS_FORGE_CONTACT_WORKER_ID=contact-fake-01

BOSS_FORGE_WORKER_ID=worker-ubuntu-01
BOSS_FORGE_ACCOUNT_ID=boss-account-01
BOSS_FORGE_RESUME_PREVIEW_ENABLED=0
BOSS_FORGE_OCR_PROVIDER=tencent
BOSS_RESUME_OCR=0
TENCENTCLOUD_SECRET_ID=CHANGE_ME_TENCENT_SECRET_ID
TENCENTCLOUD_SECRET_KEY=CHANGE_ME_TENCENT_SECRET_KEY
TENCENTCLOUD_OCR_REGION=ap-guangzhou
BOSS_BROWSER_PROFILE_DIRECTORY=Default
BOSS_BROWSER_REMOTE_DEBUGGING_PORT=53470

# No BOSS_FORGE_REAL_GREET_ENABLED here: Compose fixes it to 0 for R0-R4.
