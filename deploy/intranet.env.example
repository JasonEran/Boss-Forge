# Copy to deploy/.env.intranet; .env.* files are ignored by Git.
COMPOSE_PROJECT_NAME=boss-forge-intranet
INTRANET_BIND_IP=127.0.0.1
PUBLIC_BIND_IP=0.0.0.0
BOSS_WEB_PORT=3000
BOSS_API_PORT=3100
BOSS_HTTPS_PORT=8443
CONTROL_WEB_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_CONTROL_API_URL=http://127.0.0.1:3100

# Resolve these to approved digests before a formal internal release.
POSTGRES_IMAGE=postgres:17-alpine
NODE_IMAGE=node:22-bookworm-slim
NGINX_IMAGE=nginx:1.27-alpine
BOSS_FORGE_IMAGE=boss-forge:CHANGE_ME_RELEASE_ID
# Set both values to the same Git commit or immutable release tag.
BOSS_FORGE_RELEASE_ID=CHANGE_ME_RELEASE_ID
# Optional package mirrors for networks that cannot reliably reach deb.debian.org.
DEBIAN_MIRROR=
DEBIAN_SECURITY_MIRROR=

# Optional `https` profile. The source directory is mounted read-only.
TLS_DIRECTORY=/etc/letsencrypt
BOSS_FORGE_TLS_CERTIFICATE=/etc/letsencrypt/live/boss-forge/fullchain.pem
BOSS_FORGE_TLS_PRIVATE_KEY=/etc/letsencrypt/live/boss-forge/privkey.pem

BOSS_DB_NAME=boss_forge
BOSS_DB_USER=boss_forge
# Generate URL-safe credentials with `openssl rand -hex 32`.
BOSS_DB_PASSWORD=CHANGE_ME_BOSS_DB_PASSWORD
BOSS_FORGE_BACKUP_INTERVAL_SECONDS=86400
BOSS_FORGE_BACKUP_RETENTION_DAYS=14
BOSS_FORGE_CONTACT_WORKER_ID=contact-fake-01

# Resource guards. The host should have at least 4 GiB RAM plus 2 GiB swap
# before the headed Chromium profile is enabled.
POSTGRES_MEMORY_LIMIT=512m
POSTGRES_PIDS_LIMIT=128
BACKUP_MEMORY_LIMIT=192m
BACKUP_PIDS_LIMIT=64
MIGRATE_MEMORY_LIMIT=768m
MIGRATE_PIDS_LIMIT=256
API_MEMORY_LIMIT=512m
API_PIDS_LIMIT=192
WEB_MEMORY_LIMIT=768m
WEB_PIDS_LIMIT=256
GATEWAY_MEMORY_LIMIT=192m
GATEWAY_PIDS_LIMIT=64
CONTACT_WORKER_MEMORY_LIMIT=512m
CONTACT_WORKER_PIDS_LIMIT=192
BOSS_LOGIN_MEMORY_LIMIT=1792m
BOSS_LOGIN_PIDS_LIMIT=512
BOSS_WORKER_MEMORY_LIMIT=1792m
BOSS_WORKER_PIDS_LIMIT=512

BOSS_FORGE_BOOTSTRAP_DEPARTMENT=默认招聘部门
BOSS_FORGE_BOOTSTRAP_ADMIN_EMAIL=admin@boss-forge.internal
BOSS_FORGE_BOOTSTRAP_ADMIN_NAME=HR 管理员
BOSS_FORGE_BOOTSTRAP_PASSWORD=CHANGE_ME_BOOTSTRAP_PASSWORD

BOSS_FORGE_WORKER_ID=worker-ubuntu-01
BOSS_FORGE_ACCOUNT_ID=boss-account-01
# Leave both canary controls blank during normal operation. For an exact
# resume canary, use resume-only plus 1..20 attempts and set restart policy=no;
# restore on-failure only after the canary has been inspected and closed.
BOSS_FORGE_M1_MODE=
BOSS_FORGE_CANARY_MAX_RESUME_ATTEMPTS=
BOSS_FORGE_BOSS_LOGIN_RESTART_POLICY=on-failure
BOSS_FORGE_RESUME_PREVIEW_ENABLED=0
# Unlimited filtering/greeting by default. Set BOSS_FORGE_RESUME_QUOTAS_ENABLED=1
# only when soft daily/hourly caps are required again.
BOSS_FORGE_RESUME_QUOTAS_ENABLED=0
BOSS_FORGE_RESUME_DWELL_MIN_SECONDS=10
BOSS_FORGE_RESUME_DWELL_TARGET_SECONDS=10
BOSS_FORGE_RESUME_DWELL_MAX_SECONDS=10
BOSS_FORGE_RESUME_DAILY_LIMIT=200
BOSS_FORGE_RESUME_HOURLY_LIMIT=50
BOSS_FORGE_RESUME_BATCH_SIZE=20
BOSS_FORGE_RESUME_BREAK_MINUTES=0
BOSS_FORGE_RESUME_WORKDAY_START_HOUR=0
BOSS_FORGE_RESUME_WORKDAY_END_HOUR=24
BOSS_FORGE_OCR_PROVIDER=tencent
BOSS_RESUME_OCR=0
TENCENTCLOUD_SECRET_ID=CHANGE_ME_TENCENT_SECRET_ID
TENCENTCLOUD_SECRET_KEY=CHANGE_ME_TENCENT_SECRET_KEY
TENCENTCLOUD_OCR_REGION=ap-guangzhou
BOSS_BROWSER_PROFILE_DIRECTORY=Default
BOSS_BROWSER_REMOTE_DEBUGGING_PORT=53470
# External volumes are deliberately outside this Compose project's lifecycle.
# Existing deployment: use the exact read-only-inspected volume names; never
# create a replacement for a profile that already contains an authenticated login.
BOSS_BROWSER_PROFILE_VOLUME=CHANGE_ME_EXISTING_BROWSER_PROFILE_VOLUME
BOSS_CLI_DATA_VOLUME=CHANGE_ME_EXISTING_BOSS_CLI_DATA_VOLUME
BOSS_BROWSER_VIEWPORT_WIDTH=1100
BOSS_BROWSER_VIEWPORT_HEIGHT=820
BOSS_FORGE_LOGIN_RELAY_POLL_MS=1000

# Optional OpenAI-compatible semantic model. Enabling requires an HTTPS base URL,
# approved model, and a newly rotated non-empty API key. Keep it in shadow mode.
BOSS_FORGE_SEMANTIC_ENABLED=0
BOSS_FORGE_SEMANTIC_MODE=shadow
BOSS_FORGE_SEMANTIC_BASE_URL=
BOSS_FORGE_SEMANTIC_MODEL=
# Optional backup, used only if the primary fails; retains the configured timeout; primary is capped at 90s when a backup exists.
BOSS_FORGE_SEMANTIC_FALLBACK_MODEL=
BOSS_FORGE_SEMANTIC_API_KEY=
BOSS_FORGE_SEMANTIC_TIMEOUT_MS=45000

# Legacy variable name: enables both independent real actions only together with
# BOSS_FORGE_CONTACT_DISPATCH_MODE=real. Keep both off until deployment checks pass.
BOSS_FORGE_REAL_GREET_ENABLED=0
# Contact dispatch is independent from resume screening. Use disabled for
# preview-only, fake for isolated simulation, or real for signed HR-confirmed actions.
BOSS_FORGE_CONTACT_DISPATCH_MODE=disabled
# Real mode requires one shared deployment-specific secret of at least 32 characters.
BOSS_FORGE_CONTACT_PREVIEW_SIGNING_KEY=
BOSS_FORGE_ACCOUNT_HEALTH_MAX_AGE_MS=1800000
