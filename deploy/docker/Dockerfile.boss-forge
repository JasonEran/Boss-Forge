# syntax=dockerproxy.net/docker/dockerfile:1.7
ARG NODE_IMAGE=node:22-bookworm-slim
FROM ${NODE_IMAGE} AS runtime
ARG NEXT_PUBLIC_CONTROL_API_URL=http://127.0.0.1:3100
ARG BOSS_FORGE_RELEASE_ID=unversioned
ARG DEBIAN_MIRROR=
ARG DEBIAN_SECURITY_MIRROR=
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH NODE_ENV=production HOME=/home/node LANG=C.UTF-8 \
    npm_config_fetch_retries=5 npm_config_fetch_timeout=300000
RUN if [ -n "${DEBIAN_MIRROR}" ]; then \
        sed -i "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
    fi \
    && if [ -n "${DEBIAN_SECURITY_MIRROR}" ]; then \
        sed -i "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
    fi \
    && apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates chromium dumb-init fonts-noto-cjk xauth xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@11.22.0 --activate
ENV NEXT_PUBLIC_CONTROL_API_URL=${NEXT_PUBLIC_CONTROL_API_URL} \
    BOSS_FORGE_RELEASE_ID=${BOSS_FORGE_RELEASE_ID}
WORKDIR /app
COPY --chown=node:node . /app
# tsx is the current runtime; keep root devDependencies until standalone JS bundles exist.
RUN --mount=type=cache,id=boss-forge-pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --prod=false \
    && pnpm web:build \
    && mkdir -p /var/lib/boss-forge/runtime /var/lib/boss-forge/browser \
        /home/node/.boss-cli /home/node/.local/share/pki/nssdb \
    && chown -R node:node /app/apps/web/dist /app/apps/web/node_modules \
        /var/lib/boss-forge /home/node/.boss-cli /home/node/.local
USER node
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["pnpm", "api"]
