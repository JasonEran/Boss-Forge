# Rebuild application code from a previously verified Boss-Forge runtime image.
# This is useful when registry or Debian mirrors are unavailable; it does not
# change the browser runtime and still performs a frozen install and web build.
ARG BASE_APPLICATION_IMAGE=boss-forge:intranet
FROM ${BASE_APPLICATION_IMAGE}

ARG TARGET_NEXT_PUBLIC_CONTROL_API_URL=http://127.0.0.1:3100
ARG TARGET_BOSS_FORGE_RELEASE_ID=unversioned
ENV NEXT_PUBLIC_CONTROL_API_URL=${TARGET_NEXT_PUBLIC_CONTROL_API_URL} \
    BOSS_FORGE_RELEASE_ID=${TARGET_BOSS_FORGE_RELEASE_ID} \
    CI=true

USER root
COPY --chown=node:node . /app
WORKDIR /app
# Old macOS archives can leave AppleDouble files behind when COPY overlays
# source. In particular, ._*.sql must never reach the migration runner.
RUN find /app -type f -name '._*' -delete \
    && pnpm install --frozen-lockfile --prod=false \
    && pnpm web:build \
    && chown -R node:node /app/apps/web/dist /app/apps/web/node_modules
USER node

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["pnpm", "api"]
