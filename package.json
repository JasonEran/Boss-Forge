{
  "name": "boss-forge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit && pnpm --dir apps/web typecheck",
    "test": "vitest run",
    "test:integration:data": "tsx --env-file-if-exists=.env packages/data/src/integration-smoke.ts",
    "test:integration:odoo": "tsx --env-file-if-exists=.env packages/data/src/odoo-integration-smoke.ts",
    "test:e2e:user": "tsx --env-file-if-exists=.env apps/control-api/src/e2e-user-flow.ts",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "tsx --env-file-if-exists=.env packages/data/src/migrate.ts",
    "m1:seed": "tsx --env-file-if-exists=.env apps/control-api/src/seed.ts",
    "api": "tsx --env-file-if-exists=.env apps/control-api/src/server.ts",
    "m1:run-once": "tsx --env-file-if-exists=.env apps/boss-worker/src/m1.ts",
    "m1:worker": "tsx --env-file-if-exists=.env apps/boss-worker/src/m1.ts --loop",
    "m2:contact-worker": "tsx --env-file-if-exists=.env apps/boss-worker/src/contact-worker.ts",
    "m2:contact-worker:fake": "tsx --env-file-if-exists=.env apps/boss-worker/src/contact-worker.ts --fake",
    "odoo:sync": "tsx --env-file-if-exists=.env apps/boss-worker/src/odoo-sync.ts --loop",
    "m0": "tsx apps/boss-worker/src/m0.ts",
    "m0:doctor": "tsx apps/boss-worker/src/m0.ts doctor",
    "m0:heartbeat": "tsx apps/boss-worker/src/m0.ts heartbeat",
    "m0:install-browser": "pnpm dlx @puppeteer/browsers@3.2.1 install chrome@152.0.7977.64 --path .boss-forge/browsers",
    "worker": "tsx apps/boss-worker/src/worker.ts",
    "lint:web": "pnpm --dir apps/web lint",
    "web:dev": "pnpm --dir apps/web dev",
    "web:build": "pnpm --dir apps/web build"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
