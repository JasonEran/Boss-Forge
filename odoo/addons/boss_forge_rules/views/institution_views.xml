<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_boss_forge_institution_catalog_list" model="ir.ui.view">
        <field name="name">boss.forge.institution.catalog.list</field><field name="model">boss.forge.institution.catalog</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="version"/><field name="company_id" groups="base.group_multi_company"/><field name="source_name"/><field name="source_date"/><field name="institution_count"/><field name="state" widget="badge"/><field name="published_at"/></list></field>
    </record>
    <record id="view_boss_forge_institution_catalog_form" model="ir.ui.view">
        <field name="name">boss.forge.institution.catalog.form</field><field name="model">boss.forge.institution.catalog</field>
        <field name="arch" type="xml">
            <form>
                <header><button name="action_publish" type="object" string="Publish" class="btn-primary" invisible="state != 'draft'"/><button name="action_retire" type="object" string="Retire" invisible="state != 'published'"/><field name="state" widget="statusbar"/></header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name" readonly="state != 'draft'"/></h1></div>
                    <group><group><field name="version" readonly="state != 'draft'"/><field name="company_id" readonly="state != 'draft'"/><field name="source_name" readonly="state != 'draft'"/><field name="source_date" readonly="state != 'draft'"/><field name="source_reference" readonly="state != 'draft'"/></group><group><field name="content_hash"/><field name="published_by"/><field name="published_at"/><field name="institution_count"/></group></group>
                    <notebook><page string="Institutions"><field name="institution_ids" readonly="state != 'draft'"><list editable="bottom"><field name="code"/><field name="name"/><field name="entity_kind"/><field name="parent_id"/><field name="category_ids" widget="many2many_tags"/></list></field></page><page string="Review"><field name="validation_notes" readonly="state != 'draft'"/><field name="change_summary" readonly="state != 'draft'"/></page></notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_boss_forge_institution_list" model="ir.ui.view">
        <field name="name">boss.forge.institution.list</field><field name="model">boss.forge.institution</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="code"/><field name="catalog_id"/><field name="entity_kind"/><field name="parent_id"/><field name="category_ids" widget="many2many_tags"/></list></field>
    </record>
    <record id="view_boss_forge_institution_form" model="ir.ui.view">
        <field name="name">boss.forge.institution.form</field><field name="model">boss.forge.institution</field>
        <field name="arch" type="xml"><form><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><field name="catalog_id"/><field name="code"/><field name="country_id"/><field name="entity_kind"/><field name="parent_id"/><field name="category_ids" widget="many2many_tags"/><field name="valid_from"/><field name="valid_to"/></group><notebook><page string="Aliases"><field name="alias_ids"><list editable="bottom"><field name="raw_name"/><field name="normalized_name"/><field name="alias_type"/></list></field></page><page string="Disciplines"><field name="discipline_names"/></page><page string="Notes"><field name="notes"/></page></notebook></sheet></form></field>
    </record>
    <record id="action_boss_forge_institution_catalogs" model="ir.actions.act_window"><field name="name">Institution Catalogs</field><field name="res_model">boss.forge.institution.catalog</field><field name="view_mode">list,form</field></record>
    <record id="action_boss_forge_institutions" model="ir.actions.act_window"><field name="name">Institutions</field><field name="res_model">boss.forge.institution</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_boss_forge_institution_catalogs" name="Institution Catalogs" parent="menu_boss_forge_rules_root" action="action_boss_forge_institution_catalogs" sequence="40"/>
    <menuitem id="menu_boss_forge_institutions" name="Institutions &amp; Aliases" parent="menu_boss_forge_rules_root" action="action_boss_forge_institutions" sequence="50"/>
</odoo>
