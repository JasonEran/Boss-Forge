<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="message_template_internal_fake_v1" model="boss.forge.message.template">
        <field name="name">Internal acceptance greeting</field>
        <field name="template_code">internal_acceptance</field>
        <field name="version">1</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="state">published</field>
        <field name="body">您好 {candidate_name}，关注到您的经历与 {job_name} 岗位较匹配，方便进一步沟通吗？</field>
    </record>
    <record id="contact_policy_internal_safe_v1" model="boss.forge.contact.policy">
        <field name="name">Internal safe default</field>
        <field name="policy_code">internal_safe</field>
        <field name="version">1</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="state">published</field>
        <field name="daily_limit">20</field>
        <field name="start_hour">9</field>
        <field name="end_hour">18</field>
        <field name="cross_job_cooldown_days">30</field>
        <field name="authorization_ttl_hours">24</field>
        <field name="stop_on_uncertain">True</field>
    </record>
</odoo>
