<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_applicant_form_boss_forge" model="ir.ui.view">
        <field name="name">hr.applicant.form.boss.forge</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_bf_review_and_contact"
                    type="object"
                    string="Pass &amp; Contact"
                    class="btn-primary"
                    invisible="not bf_state_id or bf_do_not_contact or bf_contact_status in ('queued', 'processing', 'sent', 'replied')"
                />
                <button
                    name="action_bf_review_without_contact"
                    type="object"
                    string="Pass, Do Not Contact"
                    invisible="not bf_state_id or bf_review_status == 'passed'"
                />
                <button
                    name="action_bf_needs_review"
                    type="object"
                    string="Needs Review"
                    invisible="not bf_state_id or bf_review_status == 'needs_review'"
                />
                <button
                    name="action_bf_reject"
                    type="object"
                    string="Reject"
                    invisible="not bf_state_id or bf_review_status == 'rejected'"
                />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Boss-Forge Review" name="boss_forge_review" invisible="not bf_state_id">
                    <group>
                        <group string="Screening">
                            <field name="bf_screening_status" widget="badge"/>
                            <field name="bf_rule_decision" widget="badge"/>
                            <field name="bf_rule_score"/>
                            <field name="bf_rule_confidence"/>
                            <field name="bf_reason_codes"/>
                            <field name="bf_current_english_level"/>
                            <field name="bf_institution_decision" widget="badge"/>
                            <field name="bf_institution_summary"/>
                        </group>
                        <group string="Review &amp; Contact">
                            <field name="bf_review_status" widget="badge"/>
                            <field name="bf_external_review_status" widget="badge"/>
                            <field name="bf_reviewed_by"/>
                            <field name="bf_reviewed_at"/>
                            <field name="bf_review_version"/>
                            <field name="bf_contact_status" widget="badge"/>
                            <field name="bf_contact_owner_id"/>
                            <field name="bf_last_contact_at"/>
                            <field name="bf_do_not_contact"/>
                        </group>
                    </group>
                    <group>
                        <field name="bf_rejection_reason" placeholder="Required before rejecting"/>
                        <field
                            name="bf_do_not_contact_reason"
                            invisible="not bf_do_not_contact"
                            required="bf_do_not_contact"
                        />
                    </group>
                    <separator string="Rule Evidence"/>
                    <field name="bf_evidence_ids" readonly="1">
                        <list
                            decoration-success="decision == 'matched'"
                            decoration-danger="decision == 'not_matched'"
                            decoration-warning="decision == 'unknown'"
                        >
                            <field name="sequence" column_invisible="True"/>
                            <field name="requirement"/>
                            <field name="evidence_text"/>
                            <field name="normalized_label"/>
                            <field name="decision" widget="badge"/>
                            <field name="confidence"/>
                            <field name="reason_code"/>
                            <field name="dictionary_version" optional="hide"/>
                            <field name="catalog_version" optional="hide"/>
                        </list>
                    </field>
                </page>
                <page string="Education Evidence" name="boss_forge_education" invisible="not bf_state_id">
                    <field name="bf_education_ids" readonly="1">
                        <list decoration-warning="normalization_status == 'unknown'">
                            <field name="stage"/>
                            <field name="institution_raw"/>
                            <field name="institution_id"/>
                            <field name="catalog_id"/>
                            <field name="category_snapshot"/>
                            <field name="major"/>
                            <field name="normalization_status" widget="badge"/>
                            <field name="confidence"/>
                        </list>
                    </field>
                </page>
                <page string="Contact Audit" name="boss_forge_contact_audit" invisible="not bf_state_id">
                    <field name="bf_contact_authorization_ids" readonly="1">
                        <list>
                            <field name="authorization_uuid"/>
                            <field name="review_version"/>
                            <field name="reviewer_id"/>
                            <field name="reviewed_at"/>
                            <field name="transport_mode" widget="badge"/>
                            <field name="state" widget="badge"/>
                            <field name="completed_at"/>
                        </list>
                    </field>
                </page>
                <page
                    string="Technical References"
                    name="boss_forge_technical"
                    invisible="not bf_state_id"
                    groups="base.group_system"
                >
                    <group>
                        <field name="bf_source"/>
                        <field name="bf_external_candidate_id"/>
                        <field name="bf_identity_key"/>
                        <field name="bf_state_id"/>
                        <field name="bf_screening_run_id"/>
                        <field name="bf_rule_version_ref"/>
                        <field name="bf_source_fields"/>
                    </group>
                    <field name="bf_last_technical_error"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_hr_applicant_list_boss_forge" model="ir.ui.view">
        <field name="name">hr.applicant.list.boss.forge</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.crm_case_tree_view_job"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_name']" position="after">
                <field name="bf_rule_decision" widget="badge" optional="show"/>
                <field name="bf_current_english_level" optional="show"/>
                <field name="bf_institution_decision" widget="badge" optional="show"/>
                <field name="bf_review_status" widget="badge" optional="show"/>
                <field name="bf_contact_status" widget="badge" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_hr_applicant_search_boss_forge" model="ir.ui.view">
        <field name="name">hr.applicant.search.boss.forge</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='unassigned']" position="after">
                <separator/>
                <filter string="Boss-Forge Candidates" name="boss_forge" domain="[('bf_state_id', '!=', False)]"/>
                <filter string="Pending HR Review" name="bf_pending_review" domain="[('bf_review_status', '=', 'pending')]"/>
                <filter
                    string="Insufficient Information"
                    name="bf_insufficient"
                    domain="[('bf_rule_decision', 'in', ('insufficient', 'ambiguous'))]"
                />
                <filter
                    string="Pending Contact"
                    name="bf_pending_contact"
                    domain="[('bf_contact_status', 'in', ('queued', 'processing'))]"
                />
                <filter
                    string="Contact Exception"
                    name="bf_contact_exception"
                    domain="[('bf_contact_status', 'in', ('failed', 'uncertain'))]"
                />
            </xpath>
        </field>
    </record>
</odoo>
