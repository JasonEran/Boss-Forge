<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_boss_forge_template_list" model="ir.ui.view">
        <field name="name">boss.forge.message.template.list</field>
        <field name="model">boss.forge.message.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="template_code"/>
                <field name="version"/>
                <field name="company_id"/>
                <field name="state" widget="badge"/>
                <field name="published_at"/>
            </list>
        </field>
    </record>
    <record id="view_boss_forge_template_form" model="ir.ui.view">
        <field name="name">boss.forge.message.template.form</field>
        <field name="model">boss.forge.message.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_publish"
                        type="object"
                        string="Publish"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_retire"
                        type="object"
                        string="Retire"
                        invisible="state != 'published'"
                    />
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="state != 'draft'"/>
                        <field name="template_code" readonly="state != 'draft'"/>
                        <field name="version" readonly="state != 'draft'"/>
                        <field name="company_id" readonly="state != 'draft'"/>
                        <field name="published_by"/>
                        <field name="published_at"/>
                    </group>
                    <field name="body" readonly="state != 'draft'"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_boss_forge_templates" model="ir.actions.act_window">
        <field name="name">Greeting Templates</field>
        <field name="res_model">boss.forge.message.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_boss_forge_policy_list" model="ir.ui.view">
        <field name="name">boss.forge.contact.policy.list</field>
        <field name="model">boss.forge.contact.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="policy_code"/>
                <field name="version"/>
                <field name="daily_limit"/>
                <field name="cross_job_cooldown_days"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_boss_forge_policy_form" model="ir.ui.view">
        <field name="name">boss.forge.contact.policy.form</field>
        <field name="model">boss.forge.contact.policy</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_publish"
                        type="object"
                        string="Publish"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_retire"
                        type="object"
                        string="Retire"
                        invisible="state != 'published'"
                    />
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="state != 'draft'"/>
                            <field name="policy_code" readonly="state != 'draft'"/>
                            <field name="version" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="daily_limit" readonly="state != 'draft'"/>
                            <field name="start_hour" widget="float_time" readonly="state != 'draft'"/>
                            <field name="end_hour" widget="float_time" readonly="state != 'draft'"/>
                            <field name="cross_job_cooldown_days" readonly="state != 'draft'"/>
                            <field name="authorization_ttl_hours" readonly="state != 'draft'"/>
                            <field name="stop_on_uncertain" readonly="state != 'draft'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_boss_forge_policies" model="ir.actions.act_window">
        <field name="name">Contact Policies</field>
        <field name="res_model">boss.forge.contact.policy</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_boss_forge_authorization_list" model="ir.ui.view">
        <field name="name">boss.forge.contact.authorization.list</field>
        <field name="model">boss.forge.contact.authorization</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="authorization_uuid"/>
                <field name="applicant_id"/>
                <field name="job_id"/>
                <field name="reviewer_id"/>
                <field name="reviewed_at"/>
                <field name="transport_mode" widget="badge"/>
                <field name="state" widget="badge"/>
                <field name="expires_at"/>
                <field name="completed_at"/>
            </list>
        </field>
    </record>
    <record id="view_boss_forge_authorization_form" model="ir.ui.view">
        <field name="name">boss.forge.contact.authorization.form</field>
        <field name="model">boss.forge.contact.authorization</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button
                        name="action_revoke"
                        type="object"
                        string="Revoke"
                        invisible="state not in ('authorized', 'queued')"
                    />
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="authorization_uuid"/>
                            <field name="applicant_id"/>
                            <field name="job_id"/>
                            <field name="candidate_state_id"/>
                            <field name="review_version"/>
                            <field name="reviewer_id"/>
                            <field name="reviewed_at"/>
                            <field name="expires_at"/>
                        </group>
                        <group>
                            <field name="boss_account_external_id"/>
                            <field name="rule_version_ref"/>
                            <field name="template_version_ref"/>
                            <field name="policy_version_ref"/>
                            <field name="transport_mode"/>
                            <field name="outbox_event_id"/>
                            <field name="completed_at"/>
                            <field name="result_reference"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Final Message"><field name="rendered_message"/></page>
                        <page string="Immutable Snapshot"><field name="snapshot"/></page>
                        <page string="Result"><field name="error_summary"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_boss_forge_authorizations" model="ir.actions.act_window">
        <field name="name">Contact Authorizations</field>
        <field name="res_model">boss.forge.contact.authorization</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_boss_forge_recruitment_root"
        name="BOSS Sourcing"
        parent="hr.menu_hr_root"
        sequence="65"
        groups="hr_recruitment.group_hr_recruitment_user"
    />
    <menuitem
        id="menu_boss_forge_screening_runs"
        name="Screening Runs"
        parent="menu_boss_forge_recruitment_root"
        action="action_boss_forge_screening_runs"
        sequence="10"
    />
    <menuitem
        id="menu_boss_forge_schedules"
        name="Schedules"
        parent="menu_boss_forge_recruitment_root"
        action="action_boss_forge_schedules"
        sequence="20"
    />
    <menuitem
        id="menu_boss_forge_authorizations"
        name="Contact Authorizations"
        parent="menu_boss_forge_recruitment_root"
        action="action_boss_forge_authorizations"
        sequence="30"
    />
    <menuitem
        id="menu_boss_forge_accounts"
        name="BOSS Accounts"
        parent="menu_boss_forge_recruitment_root"
        action="action_boss_forge_accounts"
        sequence="40"
    />
    <menuitem
        id="menu_boss_forge_templates"
        name="Greeting Templates"
        parent="menu_boss_forge_recruitment_root"
        action="action_boss_forge_templates"
        sequence="50"
    />
    <menuitem
        id="menu_boss_forge_policies"
        name="Contact Policies"
        parent="menu_boss_forge_recruitment_root"
        action="action_boss_forge_policies"
        sequence="60"
    />
</odoo>
