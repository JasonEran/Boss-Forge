<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_bf_recruitment" model="res.groups.privilege">
        <field name="name">Boss-Forge Recruitment</field>
        <field name="sequence">12</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>
    <record id="privilege_bf_contact" model="res.groups.privilege">
        <field name="name">Boss-Forge Contact Approval</field>
        <field name="sequence">13</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>
    <record id="privilege_bf_operations" model="res.groups.privilege">
        <field name="name">Boss-Forge Operations</field>
        <field name="sequence">14</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_bf_recruiter" model="res.groups">
        <field name="name">Recruiter</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_bf_recruitment"/>
        <field name="comment">Manage only jobs where the user is primary recruiter or collaborator.</field>
        <field name="implied_ids" eval="[(4, ref('hr_recruitment.group_hr_recruitment_user'))]"/>
    </record>
    <record id="group_bf_team_lead" model="res.groups">
        <field name="name">HR Team Lead</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_bf_recruitment"/>
        <field name="comment">Manage recruitment records for allowed companies.</field>
        <field name="implied_ids" eval="[(4, ref('group_bf_recruiter'))]"/>
    </record>
    <record id="group_bf_auditor" model="res.groups">
        <field name="name">Recruitment Auditor</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_bf_recruitment"/>
        <field name="comment">Read-only business and integration audit access.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_bf_contact_approver" model="res.groups">
        <field name="name">Contact Approver</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_bf_contact"/>
        <field name="comment">May change automatic-contact switches for assigned jobs.</field>
        <field name="implied_ids" eval="[(4, ref('group_bf_recruiter'))]"/>
    </record>
    <record id="group_bf_system_operator" model="res.groups">
        <field name="name">System Operator</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_bf_operations"/>
        <field name="comment">Operate the internal connector, accounts, workers, and dead-letter queues.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
